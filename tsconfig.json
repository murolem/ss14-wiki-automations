{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "paths": {
      "$schemas/*": [
        "./src/schemas/*"
      ],
      "$logger": [
        "./src/lib/logger.ts"
      ],
      "$utils/*": [
        "./src/lib/utils/*"
      ],
      "$components/*": [
        "./src/components/*"
      ],
      "$src/*": [
        "./src/*"
      ],
      "$root/*": [
        "./*"
      ],
    },
    "sourceMap": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* Linting */
    "strict": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
  },
  "include": [
    "src",
    "test",
  ]
}