{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
    ],
    "skipLibCheck": true,
    "paths": {
      "$schemas/*": [
        "./src/schemas/*"
      ],
      "$logger": [
        "./src/lib/logger.ts"
      ],
      "$utils/*": [
        "./src/lib/utils/*"
      ],
      "$components/*": [
        "./src/components/*"
      ],
      "$src/*": [
        "./src/*"
      ],
      "$root/*": [
        "./*"
      ],
    },
    "checkJs": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "tasks"
  ]
}